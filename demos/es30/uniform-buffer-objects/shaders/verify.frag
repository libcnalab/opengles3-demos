#version 300 es
// Reads every member of three uniform blocks and compares it with the value the application packed.
// One 16x16-pixel cell per member (reading order from the top-left, 16 cells per row):
//   green   the shader sees exactly the expected value,
//   red     it does not (a failure),
//   magenta it does not, in a panel that deliberately uses a WRONG buffer layout (the "layout mistake"
//           demonstration; magenta is the expected outcome there, red would be a failure).
//
// Expected values are generated by the same formula on both sides. A member with test id ID whose
// logical scalar number is S (S counts the elements in GLSL order: array element by array element, a matrix
// column by column) holds  ID * 100 + S  (negated for signed integers). Every value is exactly
// representable in a highp float. Matrices are always written in GLSL's column-major constructor order:
// row_major changes how the bytes are stored in the buffer, never what the shader sees.
precision highp float;
precision highp int;

uniform int u_cell;       // cell size in pixels
uniform int u_height;     // surface height in pixels (rows are counted from the top)

// --- block 1: std140, instance name P, the layout rules of ES 3.0 section 2.12.6.4 ----------------------
struct Inner { float a; vec3 b; };
struct Light { vec3 position; float intensity; vec4 color; };

layout(std140) uniform Probe
{
    float f;                          //  1  offset   0
    vec3  v3;                         //  2  offset  16  (vec3: base alignment 16, size 12)
    float after_v3;                   //  3  offset  28  (packs into the vec3's fourth slot)
    vec2  v2;                         //  4  offset  32
    vec3  v3b;                        //  5  offset  48  (aligned up from 40)
    int   i;                          //  6  offset  60
    ivec2 iv2;                        //  7  offset  64
    uint  u;                          //  8  offset  72
    bool  flag_true;                  //  9  offset  76  (any non-zero uint is true)
    bool  flag_false;                 // 10  offset  80
    vec4  v4;                         // 11  offset  96
    float farr[3];                    // 12  offset 112  array stride 16
    vec2  v2arr[2];                   // 13  offset 160  array stride 16
    vec3  v3arr[2];                   // 14  offset 192  array stride 16
    mat2  m2;                         // 15  offset 224  matrix stride 16
    mat3  m3;                         // 16  offset 256  matrix stride 16
    mat4  m4;                         // 17  offset 304
    mat3x2 m3x2;                      // 18  offset 368  (3 columns of vec2, each padded to 16)
    layout(row_major) mat3 m3r;       // 19  offset 416  (3 rows of vec3, each padded to 16)
    layout(row_major) mat2x4 m2x4r;   // 20  offset 464  (4 rows of vec2, each padded to 16)
    mat3  m3arr[2];                   // 21  offset 528  array stride 48
    Inner inner;                      // 22 inner.a offset 624, 23 inner.b offset 640; the struct is padded to 656
    float after_inner;                // 24  offset 656
    Light lights[2];                  // 25..27 lights[0] at 672, 28..30 lights[1] at 704 (struct size 32)
} P;

// --- block 2: std140, no instance name; the members are global names ----------------------------------
layout(std140) uniform Mistake
{
    vec3  m_a;                        //  1  offset  0
    float m_s;                        //  2  offset 12  (a float packs into the vec3's fourth slot)
    vec3  m_b;                        //  3  offset 16
    vec3  m_c;                        //  4  offset 32
    float m_t;                        //  5  offset 44
};

// --- block 3: packed. The application must QUERY the offsets and use them ---------------------------
layout(packed) uniform Queried
{
    float q_scalar;                   //  1
    vec3  q_vec3;                     //  2
    float q_after;                    //  3
    mat3  q_mat3;                     //  4
    vec2  q_arr[2];                   //  5
    layout(row_major) mat2x3 q_row;   //  6
};

out vec4 o_color;

float F(int id, int s)   { return float(id * 100 + s); }
vec2  F2(int id, int s)  { return vec2(F(id, s), F(id, s + 1)); }
vec3  F3(int id, int s)  { return vec3(F(id, s), F(id, s + 1), F(id, s + 2)); }
vec4  F4(int id, int s)  { return vec4(F(id, s), F(id, s + 1), F(id, s + 2), F(id, s + 3)); }
int   I(int id, int s)   { return -(id * 100 + s); }
ivec2 I2(int id, int s)  { return ivec2(I(id, s), I(id, s + 1)); }
uint  U(int id, int s)   { return uint(id * 100 + s); }
mat2   M2(int id, int s)   { return mat2(F2(id, s), F2(id, s + 2)); }
mat3   M3(int id, int s)   { return mat3(F3(id, s), F3(id, s + 3), F3(id, s + 6)); }
mat4   M4(int id, int s)   { return mat4(F4(id, s), F4(id, s + 4), F4(id, s + 8), F4(id, s + 12)); }
mat3x2 M3x2(int id, int s) { return mat3x2(F2(id, s), F2(id, s + 2), F2(id, s + 4)); }   // 3 columns, 2 rows
mat2x4 M2x4(int id, int s) { return mat2x4(F4(id, s), F4(id, s + 4)); }                   // 2 columns, 4 rows
mat2x3 M2x3(int id, int s) { return mat2x3(F3(id, s), F3(id, s + 3)); }                   // 2 columns, 3 rows

int T(bool b) { return b ? 1 : 0; }

int probe(int id)
{
    switch (id)
    {
    case 1:  return T(P.f == F(1, 0));
    case 2:  return T(P.v3 == F3(2, 0));
    case 3:  return T(P.after_v3 == F(3, 0));
    case 4:  return T(P.v2 == F2(4, 0));
    case 5:  return T(P.v3b == F3(5, 0));
    case 6:  return T(P.i == I(6, 0));
    case 7:  return T(P.iv2 == I2(7, 0));
    case 8:  return T(P.u == U(8, 0));
    case 9:  return T(P.flag_true);
    case 10: return T(!P.flag_false);
    case 11: return T(P.v4 == F4(11, 0));
    case 12: return T(P.farr[0] == F(12, 0) && P.farr[1] == F(12, 1) && P.farr[2] == F(12, 2));
    case 13: return T(P.v2arr[0] == F2(13, 0) && P.v2arr[1] == F2(13, 2));
    case 14: return T(P.v3arr[0] == F3(14, 0) && P.v3arr[1] == F3(14, 3));
    case 15: return T(P.m2 == M2(15, 0));
    case 16: return T(P.m3 == M3(16, 0));
    case 17: return T(P.m4 == M4(17, 0));
    case 18: return T(P.m3x2 == M3x2(18, 0));
    case 19: return T(P.m3r == M3(19, 0));
    case 20: return T(P.m2x4r == M2x4(20, 0));
    case 21: return T(P.m3arr[0] == M3(21, 0) && P.m3arr[1] == M3(21, 9));
    case 22: return T(P.inner.a == F(22, 0));
    case 23: return T(P.inner.b == F3(23, 0));
    case 24: return T(P.after_inner == F(24, 0));
    case 25: return T(P.lights[0].position == F3(25, 0));
    case 26: return T(P.lights[0].intensity == F(26, 0));
    case 27: return T(P.lights[0].color == F4(27, 0));
    case 28: return T(P.lights[1].position == F3(28, 0));
    case 29: return T(P.lights[1].intensity == F(29, 0));
    case 30: return T(P.lights[1].color == F4(30, 0));
    }
    return -1;
}

int mistake(int id)
{
    switch (id)
    {
    case 1: return T(m_a == F3(1, 0));
    case 2: return T(m_s == F(2, 0));
    case 3: return T(m_b == F3(3, 0));
    case 4: return T(m_c == F3(4, 0));
    case 5: return T(m_t == F(5, 0));
    }
    return -1;
}

int queried(int id)
{
    switch (id)
    {
    case 1: return T(q_scalar == F(1, 0));
    case 2: return T(q_vec3 == F3(2, 0));
    case 3: return T(q_after == F(3, 0));
    case 4: return T(q_mat3 == M3(4, 0));
    case 5: return T(q_arr[0] == F2(5, 0) && q_arr[1] == F2(5, 2));
    case 6: return T(q_row == M2x3(6, 0));
    }
    return -1;
}

// Which cell tests what: 0..29 Probe; 32..36, 38..42 and 48..52 the three Mistake panels; 54..59 Queried.
int check(int cell, out bool wrong_layout_panel)
{
    wrong_layout_panel = false;
    if (cell < 30)               return probe(cell + 1);
    if (cell >= 32 && cell < 37) return mistake(cell - 31);
    if (cell >= 38 && cell < 43) { wrong_layout_panel = true; return mistake(cell - 37); }
    if (cell >= 48 && cell < 53) { wrong_layout_panel = true; return mistake(cell - 47); }
    if (cell >= 54 && cell < 60) return queried(cell - 53);
    return -1;
}

void main()
{
    ivec2 px = ivec2(gl_FragCoord.xy);
    int col = px.x / u_cell;
    int row = (u_height - 1 - px.y) / u_cell;
    ivec2 inside = ivec2(px.x % u_cell, (u_height - 1 - px.y) % u_cell);

    bool wrong_layout_panel;
    int result = check(row * 16 + col, wrong_layout_panel);
    if (result < 0 || inside.x == 0 || inside.y == 0)
    {
        o_color = vec4(0.10, 0.10, 0.12, 1.0);   // not a test cell, or the 1-pixel gap between cells
        return;
    }
    if (result == 1)                 o_color = vec4(0.0, 1.0, 0.0, 1.0);
    else if (wrong_layout_panel)     o_color = vec4(1.0, 0.0, 1.0, 1.0);
    else                             o_color = vec4(1.0, 0.0, 0.0, 1.0);
}
