#version 310 es
// Stream compaction with an ATOMIC COUNTER as the append pointer: every invocation inspects one input element and,
// if the predicate holds, appends (index, value) to a dense output list at the slot atomicCounterIncrement hands
// out. The slots are unique and gap-free, but WHICH invocation gets which slot depends on the scheduling, so the
// application validates the output as a set, not as a sequence.
//
// The input element encodes squared distance d from the centre of a 128 x 128 image; elements in the "even" rings
// (d / 300 even) are kept, so the compacted list is the set of pixels of a ring pattern.
precision highp float;
precision highp int;

layout(local_size_x = 128) in;

layout(binding = 0, offset = 0) uniform atomic_uint c_append;

layout(std430, binding = 0) readonly buffer In  { uint v[]; } src;
layout(std430, binding = 1) buffer Out
{
    uint n;               // unused here: the count is the atomic counter
    uint idx[16384];
    uint val[16384];
} dst;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint d = src.v[i];
    if (((d / 300u) & 1u) == 0u)
    {
        uint slot = atomicCounterIncrement(c_append);
        dst.idx[slot] = i;
        dst.val[slot] = d;
    }
}
