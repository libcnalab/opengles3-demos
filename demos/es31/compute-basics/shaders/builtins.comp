#version 310 es
// Every compute built-in, recorded by every invocation (GLSL ES 3.10 section 7.1.3).
//
// The host inserts exactly one line directly below the #version line before compiling, for example
//     #define LOCAL_SIZE local_size_x = 4, local_size_y = 4
// so that the same body is compiled for 1-D, 2-D and 3-D work groups. Dimensions that are not named keep
// the default local size 1 (section 4.4.1.1).
layout(LOCAL_SIZE) in;

// std430: four uvec4 = 64 bytes per record, no padding surprises.
struct Record
{
    uvec4 num_groups;  // xyz = gl_NumWorkGroups,      w = gl_LocalInvocationIndex
    uvec4 group_id;    // xyz = gl_WorkGroupID,        w = gl_WorkGroupSize.x
    uvec4 local_id;    // xyz = gl_LocalInvocationID,  w = gl_WorkGroupSize.y
    uvec4 global_id;   // xyz = gl_GlobalInvocationID, w = gl_WorkGroupSize.z
};

layout(std430, binding = 0) buffer Records
{
    Record records[];
};

uniform uint u_capacity;  // number of records the buffer holds (a safety net against a wrong gl_GlobalInvocationID)

void main()
{
    // Every invocation owns the record at the flat position of its global invocation ID, so no two
    // invocations ever write the same memory and no atomics or barriers are needed.
    uvec3 global_size = gl_NumWorkGroups * gl_WorkGroupSize;
    uint slot = gl_GlobalInvocationID.x
              + gl_GlobalInvocationID.y * global_size.x
              + gl_GlobalInvocationID.z * global_size.x * global_size.y;
    if (slot >= u_capacity)
        return;

    records[slot] = Record(uvec4(gl_NumWorkGroups, gl_LocalInvocationIndex),
                           uvec4(gl_WorkGroupID, gl_WorkGroupSize.x),
                           uvec4(gl_LocalInvocationID, gl_WorkGroupSize.y),
                           uvec4(gl_GlobalInvocationID, gl_WorkGroupSize.z));
}
