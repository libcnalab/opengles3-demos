#version 310 es
// Second pass of the dependent chain vecadd -> transform: reads what the previous dispatch wrote.
// Needs glMemoryBarrier(SHADER_STORAGE_BARRIER_BIT) between the two dispatches (ES 3.2 section 7.11.2).
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Source { float src[]; };
layout(std430, binding = 1) writeonly buffer Result { uint dst[]; };

uniform uint u_count;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < u_count)
    {
        uint v = uint(src[i]);                  // the fractional part is dropped (GLSL ES 3.10 section 5.4.1)
        dst[i] = (v * 2654435761u) ^ (v >> 5);  // highp unsigned arithmetic wraps modulo 2^32 (section 4.1.3)
    }
}
