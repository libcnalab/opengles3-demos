#version 310 es
// Negative case: "It is a compile-time error to use gl_WorkGroupSize in a shader that does not declare a
// fixed local group size, or before that shader has declared a fixed local group size" (GLSL ES 3.10
// section 7.1.3).
layout(std430, binding = 0) buffer Sink { uint sink[]; };

void main()
{
    sink[0] = gl_WorkGroupSize.x;
}
