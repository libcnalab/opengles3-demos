#version 310 es
// Pass 2: launched with glDispatchComputeIndirect. Every 8 x 8 work group paints one tile; neighbouring tiles
// alternate between an orange x-ramp and a blue y-ramp, and the first texel of every group is white, so the picture
// shows the work group structure that the indirect command produced.
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform writeonly highp image2D u_img;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tile = ivec2(gl_WorkGroupID.xy);
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    vec3 c;
    if (((tile.x + tile.y) & 1) == 0)
        c = vec3(0.9, 0.5, 0.1) * (0.4 + 0.6 * float(l.x) / 7.0);
    else
        c = vec3(0.1, 0.5, 0.9) * (0.4 + 0.6 * float(l.y) / 7.0);
    if (l.x == 0 && l.y == 0)
        c = vec3(1.0);
    imageStore(u_img, p, vec4(c, 1.0));
}
