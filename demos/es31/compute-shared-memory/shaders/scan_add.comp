#version 310 es
// Third pass of the hierarchical scan: add to every element the inclusive scan of all work groups before its own.
// No shared memory is needed here: each invocation reads and writes only its own element, and the previous
// dispatches' results are made visible with glMemoryBarrier(SHADER_STORAGE_BARRIER_BIT) on the host.
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Scanned { int scanned[]; };  // inclusive scan within each work group
layout(std430, binding = 1) readonly buffer Offsets { int offsets[]; };  // inclusive scan of the group totals
layout(std430, binding = 2) writeonly buffer Result { int result[]; };   // inclusive scan of the whole array

uniform uint u_count;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint g = gl_WorkGroupID.x;
    if (i < u_count)
        result[i] = scanned[i] + (g > 0u ? offsets[g - 1u] : 0);
}
