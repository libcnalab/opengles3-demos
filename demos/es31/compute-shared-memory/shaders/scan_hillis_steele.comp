#version 310 es
// Inclusive prefix sum (scan) of one work group of 128 elements with the Hillis-Steele algorithm: log2(128) = 7 steps,
// in step k every element adds the element 2^k places to its left.
//
// Every step has TWO hazards, so it has two barriers:
//   read phase   addend = s[lid - offset]
//   (barrier)    write-after-read: no invocation may overwrite s[] before all invocations have read their addend
//   write phase  s[lid] += addend
//   (barrier)    read-after-write: the next step must see every invocation's new value
// Without the first barrier, a fast invocation could add into s[lid] before a slow neighbour read the old value
// (the demo's CPU simulation shows an execution order that produces a wrong scan).
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Values { int values[]; };
layout(std430, binding = 1) writeonly buffer Scanned { int scanned[]; };  // inclusive scan within each work group
layout(std430, binding = 2) writeonly buffer Totals { int totals[]; };    // sum of each work group

uniform uint u_count;

shared int s[128];

void main()
{
    uint lid = gl_LocalInvocationID.x;
    uint i = gl_GlobalInvocationID.x;

    s[lid] = (i < u_count) ? values[i] : 0;  // padding with 0 keeps the group total correct for the last, partial group
    memoryBarrierShared();
    barrier();

    for (uint offset = 1u; offset < 128u; offset <<= 1u)
    {
        int addend = (lid >= offset) ? s[lid - offset] : 0;
        memoryBarrierShared();
        barrier();
        s[lid] += addend;
        memoryBarrierShared();
        barrier();
    }

    if (i < u_count)
        scanned[i] = s[lid];
    if (lid == 127u)
        totals[gl_WorkGroupID.x] = s[127];
}
