#version 310 es
// Writes a gradient into one face of a cube map through a non-layered image2D binding.
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) uniform writeonly highp image2D u_img;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    imageStore(u_img, p, vec4(float(p.x) / 7.0, float(p.y) / 7.0, 0.5, 1.0));
}
