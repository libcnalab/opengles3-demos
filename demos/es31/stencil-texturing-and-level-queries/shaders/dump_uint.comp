#version 310 es
// The stencil index of a depth/stencil texture, read in the shader with texelFetch and with textureLod at
// the texel centre through an unsigned integer sampler. Layout as in dump_float.comp, raw uint values.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform highp usampler2D u_tex;

layout(std430, binding = 0) buffer Dump
{
    uint data[];
};

void main()
{
    ivec2 size = textureSize(u_tex, 0);
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= size.x || xy.y >= size.y) return;
    uint texel = uint(xy.y * size.x + xy.x);
    uint count = uint(size.x * size.y);

    uvec4 fetched = texelFetch(u_tex, xy, 0);
    uvec4 sampled = textureLod(u_tex, (vec2(xy) + 0.5) / vec2(size), 0.0);
    for (int c = 0; c < 4; ++c)
    {
        data[4u * texel + uint(c)] = fetched[c];
        data[4u * count + 4u * texel + uint(c)] = sampled[c];
    }
}
