#version 310 es
// @expect: compile-fail
// @spec: GLSL ES 3.10 §4.4.7 - a float image (image2D) must use a float format qualifier, not rgba8i
// @feature: GLSL310.IMAGES
layout(local_size_x = 1) in;
layout(rgba8i, binding = 0) readonly uniform highp image2D u_img;
void main() { vec4 v = imageLoad(u_img, ivec2(0)); }
